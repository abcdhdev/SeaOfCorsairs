# Unity text assets should stay diffable and mergeable.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D text eol=lf
*.physicMaterial text eol=lf
*.playable text eol=lf
*.renderTexture text eol=lf
*.shader text eol=lf
*.shadersubgraph text eol=lf
*.shadergraph text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.asmdef text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Large and binary game assets go through Git LFS.
*.aiff filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
