:root {
    position: absolute;
    left: 0;
    top: 0;
    width: 1930px;
    height: 300px;
    justify-content: center;
    align-items: center;
}

#NameplateRoot {
    width: 1930px;
    height: 300px;
}

.nameplate-root {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    row-gap: 16px;
    padding-top: 12px;
    padding-right: 20px;
    padding-bottom: 14px;
    padding-left: 20px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgba(224, 177, 94, 0.92);
    border-right-color: rgba(224, 177, 94, 0.92);
    border-bottom-color: rgba(224, 177, 94, 0.92);
    border-left-color: rgba(224, 177, 94, 0.92);
    background-color: rgba(10, 8, 2, 0.92);
}

.entity-name-label {
    color: rgba(255, 236, 184, 0.99);
    font-size: 192px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 8px;
}

.health-bar-bg {
    position: relative;
    width: 86%;
    height: 90px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    overflow: hidden;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgba(34, 128, 36, 0.95);
    border-right-color: rgba(34, 128, 36, 0.95);
    border-bottom-color: rgba(34, 128, 36, 0.95);
    border-left-color: rgba(34, 128, 36, 0.95);
    background-color: rgba(4, 36, 11, 1);
}

.health-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: rgba(3, 141, 33, 1);
}

.health-bar-label {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: rgba(255, 232, 192, 0.98);
    -unity-font-style: bold;
    font-size: 52px;
    -unity-text-align: middle-center;
}
