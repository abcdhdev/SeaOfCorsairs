:root {
    position: absolute;
    left: 0;
    top: 0;
    width: 1930px;
    height: 300px;
    justify-content: center;
    align-items: center;
}

#NameplateRoot {
    width: 1930px;
    height: 300px;
}

.nameplate-root {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    row-gap: 0;
    padding-top: 12px;
    padding-right: 20px;
    padding-bottom: 14px;
    padding-left: 20px;
}

.nameplate-name-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
    column-gap: 10px;
}

.guild-prefix-label {
    color: rgba(255, 221, 102, 0.99);
    font-size: 94px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 6px;
}

.entity-name-label {
    color: rgba(255, 236, 184, 0.99);
    font-size: 168px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 8px;
}

.health-bar-bg {
    position: relative;
    width: 93%;
    height: 58px;
    margin-top: 18px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(34, 128, 36, 0.95);
    border-right-color: rgba(34, 128, 36, 0.95);
    border-bottom-color: rgba(34, 128, 36, 0.95);
    border-left-color: rgba(34, 128, 36, 0.95);
    background-color: rgba(4, 36, 11, 1);
}

.health-bar-damage-trail,
.health-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
}

.health-bar-damage-trail {
    background-color: rgba(181, 72, 44, 0.92);
}

.health-bar-fill {
    background-color: rgba(3, 141, 33, 1);
}

.health-bar-slice {
    position: absolute;
    top: -10px;
    bottom: -10px;
    left: 100%;
    width: 34px;
    display: none;
    opacity: 0;
    background-color: rgba(255, 241, 199, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 201, 117, 0.98);
    border-right-color: rgba(255, 201, 117, 0.98);
    border-bottom-color: rgba(255, 201, 117, 0.98);
    border-left-color: rgba(255, 201, 117, 0.98);
}

.health-bar-label {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: rgba(255, 232, 192, 0.98);
    -unity-font-style: bold;
    font-size: 52px;
    -unity-text-align: middle-center;
}
