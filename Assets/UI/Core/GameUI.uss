}

.mmo-chat-line-system {
    color: rgba(171, 230, 163, 0.97);
}

.mmo-chat-input-row {
    margin-top: 8px;
    flex-direction: row;
}

.mmo-chat-input-field {
    flex-grow: 1;
    margin-right: 8px;
    min-height: 34px;
}

.mmo-chat-input-field > .unity-base-field__label {
    display: none;
}

.mmo-chat-input-field > .unity-base-field__input {
    margin-left: 0;
}

.mmo-chat-input-field .unity-base-text-field__input {
