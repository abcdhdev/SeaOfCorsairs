}

.mmo-chat-messages-scroll .unity-scroll-view__content-container {
    flex-direction: column;
}

.mmo-chat-messages-content {
    flex-direction: column;
    row-gap: 4px;
}

.mmo-chat-line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.mmo-chat-line-time {
    margin-right: 7px;
    color: rgba(142, 134, 121, 0.9);
    font-size: 12px;
}

.mmo-chat-line-channel {
    margin-right: 7px;
