    border-right-width: 1px;
}

.top-menu-slot-button {
    width: 56px;
    min-width: 56px;
    height: 54px;
    min-height: 54px;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(111, 67, 28, 0.95);
