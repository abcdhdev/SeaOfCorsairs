:root {
    --action-slot-size: 68px;
    --hud-panel-bg: rgba(22, 11, 2, 0.94);
    --hud-panel-border: rgba(203, 125, 8, 0.95);
    --hud-slot-bg: rgba(8, 4, 1, 0.97);
    --hud-slot-bg-hover: rgba(36, 18, 3, 0.98);
    --hud-slot-border: rgba(203, 125, 8, 0.85);
    --hud-slot-text: rgba(255, 212, 147, 0.98);
    --hud-slot-text-muted: rgba(168, 150, 125, 0.72);
    --hud-green-fill: rgba(32, 150, 48, 0.95);
    --hud-green-bg: rgb(4, 36, 11);
    --hud-red-fill: rgba(120, 16, 12, 0.95);
    --hud-red-bg: rgb(41, 4, 4);
}

.hud-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.meta-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.dead-overlay-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(3, 6, 10, 0.7);
}

.dead-overlay-panel {
    min-width: 420px;
    max-width: 90%;
    padding-top: 24px;
    padding-right: 28px;
    padding-bottom: 24px;
    padding-left: 28px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(194, 84, 55, 0.95);
    border-right-color: rgba(194, 84, 55, 0.95);
    border-bottom-color: rgba(194, 84, 55, 0.95);
    border-left-color: rgba(194, 84, 55, 0.95);
    background-color: rgba(16, 8, 3, 0.97);
    align-items: center;
}

.dead-overlay-title {
    color: rgb(247, 204, 159);
    -unity-font-style: bold;
    font-size: 44px;
    -unity-text-align: middle-center;
}

.dead-overlay-timer {
    margin-top: 10px;
    color: rgba(228, 174, 98, 0.96);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.bottom-hud-container {
    position: absolute;
    right: auto;
    bottom: 26px;
    left: 500px;
    flex-direction: row;
    align-content: center;
    align-items: flex-end;
}

.island-edit-root {
    position: absolute;
    right: 90px;
    bottom: 18px;
    left: 350px;
    display: none;
    align-items: center;
}

.island-edit-banner {
    margin-bottom: 8px;
    padding-top: 4px;
    padding-right: 14px;
    padding-bottom: 4px;
    padding-left: 14px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    background-color: rgba(8, 23, 31, 0.9);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(99, 183, 206, 0.68);
    border-right-color: rgba(99, 183, 206, 0.68);
    border-bottom-color: rgba(99, 183, 206, 0.68);
    border-left-color: rgba(99, 183, 206, 0.68);
    color: rgba(214, 244, 255, 0.96);
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 0.9px;
    text-transform: uppercase;
}

.island-edit-info-panel {
    width: 860px;
    max-width: 100%;
    flex-direction: row;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 8px;
    padding-top: 14px;
    padding-right: 18px;
    padding-bottom: 14px;
    padding-left: 18px;
    background-color: rgba(10, 14, 20, 0.95);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(205, 138, 52, 0.78);
    border-right-color: rgba(205, 138, 52, 0.78);
    border-bottom-color: rgba(205, 138, 52, 0.78);
    border-left-color: rgba(205, 138, 52, 0.78);
}

.island-edit-info-column {
    flex-grow: 1;
    min-width: 0;
}

.island-edit-info-column-right {
    align-items: flex-end;
}

.island-edit-info-title {
    color: rgba(255, 214, 163, 0.96);
    -unity-font-style: bold;
    font-size: 12px;
    text-transform: uppercase;
}

.island-edit-info-line {
    margin-top: 4px;
    color: rgba(241, 228, 210, 0.98);
    font-size: 14px;
}

.island-edit-info-line-muted {
    color: rgba(182, 190, 196, 0.86);
}

.island-build-catalog {
    width: 860px;
    max-width: 100%;
    display: none;
    justify-content: center;
    margin-bottom: 8px;
}

.island-build-card {
    min-width: 240px;
    height: 44px;
    padding-right: 18px;
    padding-left: 18px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(87, 170, 118, 0.92);
    border-right-color: rgba(87, 170, 118, 0.92);
    border-bottom-color: rgba(87, 170, 118, 0.92);
    border-left-color: rgba(87, 170, 118, 0.92);
    background-color: rgba(15, 48, 29, 0.96);
    color: rgba(230, 248, 234, 0.98);
    -unity-font-style: bold;
    font-size: 13px;
}

.island-build-card:hover {
    background-color: rgba(24, 70, 41, 0.99);
}

.island-edit-status-label {
    width: 860px;
    max-width: 100%;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-right: 14px;
    padding-bottom: 8px;
    padding-left: 14px;
    background-color: rgba(8, 12, 18, 0.9);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    color: rgba(216, 223, 230, 0.96);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.island-edit-bar {
    width: 860px;
    max-width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
    background-color: rgba(15, 9, 3, 0.96);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(204, 129, 28, 0.88);
    border-right-color: rgba(204, 129, 28, 0.88);
    border-bottom-color: rgba(204, 129, 28, 0.88);
    border-left-color: rgba(204, 129, 28, 0.88);
}

.island-edit-button-group {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.island-edit-button-group-right {
    justify-content: flex-end;
}

.island-edit-button {
    min-width: 106px;
    height: 38px;
    padding-right: 14px;
    padding-left: 14px;
    color: rgba(250, 232, 203, 0.98);
    -unity-font-style: bold;
    font-size: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.island-edit-button-primary {
    border-top-color: rgba(80, 162, 109, 0.92);
    border-right-color: rgba(80, 162, 109, 0.92);
    border-bottom-color: rgba(80, 162, 109, 0.92);
    border-left-color: rgba(80, 162, 109, 0.92);
    background-color: rgba(24, 63, 41, 0.96);
}

.island-edit-button-primary:hover {
    background-color: rgba(31, 82, 52, 0.98);
}

.island-edit-button-secondary {
    border-top-color: rgba(106, 126, 154, 0.92);
    border-right-color: rgba(106, 126, 154, 0.92);
    border-bottom-color: rgba(106, 126, 154, 0.92);
    border-left-color: rgba(106, 126, 154, 0.92);
    background-color: rgba(19, 28, 40, 0.95);
}

.island-edit-button-secondary:hover {
    background-color: rgba(28, 40, 57, 0.98);
}

.island-edit-button-danger {
    border-top-color: rgba(168, 84, 73, 0.92);
    border-right-color: rgba(168, 84, 73, 0.92);
    border-bottom-color: rgba(168, 84, 73, 0.92);
    border-left-color: rgba(168, 84, 73, 0.92);
    background-color: rgba(78, 23, 24, 0.96);
}

.island-edit-button-danger:hover {
    background-color: rgba(100, 31, 31, 0.98);
}

.island-edit-button-exit {
    border-top-color: rgba(199, 150, 79, 0.92);
    border-right-color: rgba(199, 150, 79, 0.92);
    border-bottom-color: rgba(199, 150, 79, 0.92);
    border-left-color: rgba(199, 150, 79, 0.92);
    background-color: rgba(71, 48, 14, 0.96);
}

.island-edit-button-exit:hover {
    background-color: rgba(96, 61, 17, 0.98);
}

.action-bar-toggle-button {
    width: 32px;
    min-height: 186px;
    margin-right: 8px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    background-color: rgba(32, 16, 2, 0.96);
    color: var(--hud-slot-text);
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.action-bar-toggle-button:hover {
    background-color: rgba(58, 28, 4, 0.98);
}

.action-bar-toggle-button.action-bar-toggle-closed {
    min-height: 54px;
}

.action-bar-body {
    flex-grow: 0;
    flex-shrink: 0;
    max-width: 1540px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    background-color: var(--hud-panel-bg);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.action-bar-body.action-bar-closed {
    display: none;
}

.status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.status-bar {
    position: relative;
    height: 28px;
    flex-grow: 1;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    overflow: hidden;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.hp-bar {
    margin-right: 6px;
    background-color: var(--hud-green-bg);
    border-top-color: rgba(55, 162, 57, 0.92);
    border-right-color: rgba(55, 162, 57, 0.92);
    border-bottom-color: rgba(55, 162, 57, 0.92);
    border-left-color: rgba(55, 162, 57, 0.92);
}

.exp-bar {
    margin-left: 6px;
    background-color: var(--hud-red-bg);
    border-top-color: rgba(124, 41, 20, 0.95);
    border-right-color: rgba(124, 41, 20, 0.95);
    border-bottom-color: rgba(124, 41, 20, 0.95);
    border-left-color: rgba(124, 41, 20, 0.95);
}

.status-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
}

.hp-fill {
    background-color: var(--hud-green-fill);
}

.exp-fill {
    background-color: var(--hud-red-fill);
}

.status-bar-label {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: var(--hud-slot-text);
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.center-camera-button {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    background-color: rgba(20, 12, 2, 0.98);
    color: rgba(255, 216, 149, 0.98);
    -unity-font-style: bold;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.center-camera-button:hover {
    background-color: rgba(49, 24, 3, 0.99);
}

.slot-row {
    flex-direction: row;
    align-items: stretch;
}

.bottom-skill-slot-row {
    margin-top: 6px;
}

.action-slot {
    position: relative;
    width: var(--action-slot-size);
    min-width: var(--action-slot-size);
    max-width: var(--action-slot-size);
    height: var(--action-slot-size);
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 5px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 4px;
    padding-left: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--hud-slot-border);
    border-right-color: var(--hud-slot-border);
    border-bottom-color: var(--hud-slot-border);
    border-left-color: var(--hud-slot-border);
    background-color: var(--hud-slot-bg);
    overflow: hidden;
    opacity: 1;
    font-size: 10px;
}

.action-slot.action-slot-last {
    margin-right: 0;
}

.action-slot:hover {
    background-color: var(--hud-slot-bg-hover);
}

.action-slot-label-top {
    font-size: 15px;
    color: var(--hud-slot-text);
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.action-slot-label-main {
    flex-grow: 1;
    font-size: 13px;
    color: var(--hud-slot-text);
    -unity-text-align: middle-center;
}

.action-slot-icon {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    -unity-background-scale-mode: scale-and-crop;
}

.action-slot-icon-1 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/1.png");
}

.action-slot-icon-2 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/2.png");
}

.action-slot-icon-3 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/3.png");
}

.action-slot-icon-4 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/4.png");
}

.action-slot-icon-5 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/5.png");
}

.action-slot-icon-6 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/6.png");
}

.action-slot-icon-7 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/7.png");
}

.action-slot-icon-8 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/8.png");
}

.action-slot-icon-9 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/9.png");
}

.action-slot-icon-10 {
    background-image: url("project://database/Assets/UI/Art/Icons/Skills/10.png");
}

.top-action-slot.action-slot-empty .action-slot-label-main {
    color: var(--hud-slot-text-muted);
}

.top-action-slot.action-slot-has-skill {
    background-color: rgba(26, 22, 5, 0.97);
}

.skill-source-slot {
    background-color: rgba(42, 18, 4, 0.97);
}

.action-slot.action-slot-disabled {
    opacity: 0.35;
}

.action-slot.action-slot-disabled:hover {
    background-color: var(--hud-slot-bg);
}

.action-slot-drop-target {
    border-top-color: rgba(64, 188, 65, 0.95);
    border-right-color: rgba(64, 188, 65, 0.95);
    border-bottom-color: rgba(64, 188, 65, 0.95);
    border-left-color: rgba(64, 188, 65, 0.95);
    background-color: rgba(16, 56, 18, 0.94);
}

.drag-ghost {
    position: absolute;
    width: 160px;
    height: 42px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 175, 48, 0.98);
    border-right-color: rgba(255, 175, 48, 0.98);
    border-bottom-color: rgba(255, 175, 48, 0.98);
    border-left-color: rgba(255, 175, 48, 0.98);
    background-color: rgba(20, 10, 1, 0.96);
    color: var(--hud-slot-text);
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.ammo-menu-backdrop {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.25);
}

.ammo-menu-panel {
    flex-direction: column;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-color: var(--hud-panel-bg);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.ammo-menu-button {
    height: 44px;
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    background-color: rgba(20, 12, 2, 0.98);
    color: var(--hud-slot-text);
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-align: middle-left;
}

.ammo-menu-button:hover {
    background-color: rgba(49, 24, 3, 0.99);
}

.ammo-menu-button.ammo-menu-button-selected {
    border-top-color: rgba(64, 188, 65, 0.95);
    border-right-color: rgba(64, 188, 65, 0.95);
    border-bottom-color: rgba(64, 188, 65, 0.95);
    border-left-color: rgba(64, 188, 65, 0.95);
    background-color: rgba(16, 56, 18, 0.94);
}

.combat-overlay-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
}

.health-box {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 430px;
    max-width: 90%;
    min-height: 92px;
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    background-color: var(--hud-panel-bg);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.health-portrait {
    width: 72px;
    height: 72px;
    margin-right: 10px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-top-color: rgb(10, 63, 127);
    border-right-color: rgb(10, 63, 127);
    border-bottom-color: rgb(10, 63, 127);
    border-left-color: rgb(10, 63, 127);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgba(9, 38, 80, 0.95);
    background-image: url("project://database/Assets/Textures/Ship/Ship01_Material_BaseMap.png?fileID=2800000&guid=1c4e474170c828c4f8216190dcb0c3f2&type=3#Ship01_Material_BaseMap");
    -unity-background-scale-mode: scale-and-crop;
}

.health-content {
    flex-grow: 1;
    justify-content: center;
}

.health-name-label {
    margin-bottom: 6px;
    color: rgba(214, 205, 186, 0.92);
    font-size: 28px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.health-label {
    color: rgba(255, 212, 147, 0.98);
    -unity-font-style: bold;
    font-size: 26px;
    -unity-text-align: middle-center;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.health-bar-bg {
    position: relative;
    height: 30px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    overflow: hidden;
    background-color: rgb(4, 36, 11);
    border-top-color: rgba(34, 128, 36, 0.95);
    border-right-color: rgba(34, 128, 36, 0.95);
    border-bottom-color: rgba(34, 128, 36, 0.95);
    border-left-color: rgba(34, 128, 36, 0.95);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.health-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: rgb(3, 141, 33);
}

.minimap-root {
    position: absolute;
    top: 58px;
    right: 16px;
    width: 236px;
    align-items: stretch;
}

.minimap-frame {
    width: 236px;
    height: 236px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(210, 130, 22, 0.95);
    border-right-color: rgba(210, 130, 22, 0.95);
    border-bottom-color: rgba(210, 130, 22, 0.95);
    border-left-color: rgba(210, 130, 22, 0.95);
    background-color: rgba(10, 7, 2, 0.9);
}

.minimap-mask {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(227, 182, 114, 0.7);
    border-right-color: rgba(227, 182, 114, 0.7);
    border-bottom-color: rgba(227, 182, 114, 0.7);
    border-left-color: rgba(227, 182, 114, 0.7);
    background-color: rgba(2, 15, 23, 0.96);
}

.minimap-render {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/Textures/UI/RaceMap.png?fileID=2800000&guid=130e622513017468e8e720b340c74e16&type=3#RaceMap");
    background-color: rgb(8, 26, 35);
}

.minimap-marker-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.minimap-viewport-border {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.minimap-marker {
    position: absolute;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.minimap-marker-player {
    background-color: rgba(78, 200, 255, 0.98);
    border-top-color: rgba(197, 239, 255, 0.96);
    border-right-color: rgba(197, 239, 255, 0.96);
    border-bottom-color: rgba(197, 239, 255, 0.96);
    border-left-color: rgba(197, 239, 255, 0.96);
}

.minimap-marker-npc {
    background-color: rgba(255, 86, 56, 0.98);
    border-top-color: rgba(255, 201, 186, 0.95);
    border-right-color: rgba(255, 201, 186, 0.95);
    border-bottom-color: rgba(255, 201, 186, 0.95);
    border-left-color: rgba(255, 201, 186, 0.95);
}

.minimap-marker-offscreen {
    opacity: 0.86;
    border-top-color: rgb(255, 238, 181);
    border-right-color: rgb(255, 238, 181);
    border-bottom-color: rgb(255, 238, 181);
    border-left-color: rgb(255, 238, 181);
}

.minimap-center-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(212, 255, 197);
    border-right-color: rgb(212, 255, 197);
    border-bottom-color: rgb(212, 255, 197);
    border-left-color: rgb(212, 255, 197);
    background-color: rgba(39, 121, 49, 0.96);
}

.minimap-info-row {
    margin-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    justify-content: space-between;
}

.minimap-mode-label,
.minimap-zoom-label {
    color: rgba(243, 211, 159, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.camera-zoom-root {
    position: absolute;
    left: auto;
    right: 16px;
    bottom: 18px;
    width: 36px;
    height: 248px;
    align-items: center;
    justify-content: center;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
}

.camera-zoom-slider {
    width: 32px;
    height: 246px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(203, 125, 8, 0.95);
    border-right-color: rgba(203, 125, 8, 0.95);
    border-bottom-color: rgba(203, 125, 8, 0.95);
    border-left-color: rgba(203, 125, 8, 0.95);
    background-color: rgba(59, 8, 7, 0.98);
    overflow: hidden;
}

.camera-zoom-slider .unity-base-slider__label {
    display: none;
}

.camera-zoom-slider .unity-base-slider__input {
    margin-left: 0;
    min-height: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.camera-zoom-slider .unity-base-slider__tracker {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.camera-zoom-slider .unity-slider__tracker {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.camera-zoom-slider .unity-base-slider__drag-container {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.camera-zoom-slider .unity-base-slider__dragger {
    width: 32px;
    height: 16px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(148, 86, 14);
    border-right-color: rgb(148, 86, 14);
    border-bottom-color: rgb(148, 86, 14);
    border-left-color: rgb(148, 86, 14);
    background-color: rgba(0, 0, 0, 0);
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    opacity: 0;
}

.camera-zoom-slider .unity-slider__dragger {
    width: 32px;
    margin-left: 0;
    opacity: 0;
}

.camera-zoom-slider .unity-base-slider__dragger-border {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    opacity: 0;
}

.camera-zoom-slider .unity-base-slider__dragger-tracker,
.camera-zoom-slider .unity-slider__dragger-tracker {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.camera-zoom-thumb {
    position: absolute;
    left: -4px;
    top: 1px;
    width: 40px;
    height: 16px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
