.mmo-chat-root {
    position: absolute;
    left: 72px;
    bottom: 18px;
    width: 520px;
    max-width: 44%;
    min-width: 320px;
    min-height: 96px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-color: rgba(11, 7, 2, 0.94);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.mmo-chat-root.mmo-chat-closed {
    width: 250px;
    min-width: 250px;
    padding-bottom: 8px;
}

.mmo-chat-header {
    flex-direction: row;
    align-items: center;
}

.mmo-chat-title {
    flex-grow: 1;
    color: var(--hud-slot-text);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.mmo-chat-unread {
    min-width: 42px;
    height: 26px;
    margin-right: 8px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    background-color: rgba(146, 36, 17, 0.97);
    border-top-color: rgba(210, 90, 58, 0.95);
    border-right-color: rgba(210, 90, 58, 0.95);
    border-bottom-color: rgba(210, 90, 58, 0.95);
    border-left-color: rgba(210, 90, 58, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    color: rgb(255, 233, 220);
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.mmo-chat-toggle {
    width: 38px;
    height: 32px;
    min-width: 38px;
    min-height: 32px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--hud-panel-border);
    border-right-color: var(--hud-panel-border);
    border-bottom-color: var(--hud-panel-border);
    border-left-color: var(--hud-panel-border);
    background-color: rgba(20, 12, 2, 0.98);
    color: var(--hud-slot-text);
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.mmo-chat-toggle:hover {
    background-color: rgba(48, 25, 4, 0.99);
}

.mmo-chat-body {
    margin-top: 8px;
    flex-direction: column;
}

.mmo-chat-root.mmo-chat-closed .mmo-chat-body {
    display: none;
}

.mmo-chat-channels-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.mmo-chat-channel-button {
    flex-grow: 1;
    height: 32px;
    margin-right: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(172, 119, 42, 0.88);
    border-right-color: rgba(172, 119, 42, 0.88);
    border-bottom-color: rgba(172, 119, 42, 0.88);
    border-left-color: rgba(172, 119, 42, 0.88);
    background-color: rgba(17, 10, 2, 0.97);
    color: var(--hud-slot-text-muted);
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.mmo-chat-channel-button:hover {
    background-color: rgba(36, 19, 3, 0.98);
    color: var(--hud-slot-text);
}

.mmo-chat-channel-button.mmo-chat-channel-selected {
    border-top-color: rgba(64, 188, 65, 0.95);
    border-right-color: rgba(64, 188, 65, 0.95);
    border-bottom-color: rgba(64, 188, 65, 0.95);
    border-left-color: rgba(64, 188, 65, 0.95);
    background-color: rgba(14, 45, 16, 0.94);
    color: rgb(201, 255, 198);
}

.mmo-chat-channels-row > .mmo-chat-channel-button {
    margin-right: 0;
}

.mmo-chat-messages-scroll {
    height: 188px;
    min-height: 140px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(130, 90, 28, 0.92);
    border-right-color: rgba(130, 90, 28, 0.92);
    border-bottom-color: rgba(130, 90, 28, 0.92);
    border-left-color: rgba(130, 90, 28, 0.92);
