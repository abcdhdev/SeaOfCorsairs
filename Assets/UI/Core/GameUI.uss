}

.top-menu-icon-shield {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_shield.svg");
}

.top-menu-icon-compass {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_compass.svg");
}

.top-menu-icon-clipboard {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_clipboard.svg");
}

.top-menu-icon-star {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_star.svg");
}

.top-menu-icon-bag {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_bag.svg");
}

.top-menu-icon-ship {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_ship.svg");
}

.top-menu-icon-trophy {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_trophy.svg");
}

.top-menu-icon-news {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_news.svg");
}

.top-menu-icon-settings {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_settings.svg");
}

.top-menu-resource-card {
    width: 330px;
    height: 48px;
    margin-left: 10px;
    margin-right: 10px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-color: rgba(130, 84, 39, 0.95);
    border-width: 1px;
    border-radius: 10px;
    background-color: rgba(24, 10, 14, 0.98);
}

.resource-inline {
    flex-direction: row;
    align-items: center;
}

.resource-inline-center {
    width: 24px;
    justify-content: center;
}

.resource-inline-icon {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    margin-right: 6px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.resource-inline-icon-center {
    width: 22px;
    min-width: 22px;
    height: 22px;
    min-height: 22px;
    margin-right: 0;
}

.resource-icon-gold {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_gold.svg");
}

.resource-icon-center {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_center.svg");
}

.resource-icon-diamond {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_diamond.svg");
}

.resource-inline-value {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.resource-inline-value-gold {
    color: rgb(224, 182, 102);
}

.resource-inline-value-blue {
    color: rgb(86, 203, 255);
}

.top-menu-logout-button {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 36px;
    min-width: 36px;
    height: 36px;
    min-height: 36px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
    align-items: center;
    justify-content: center;
    border-color: rgba(125, 86, 40, 0.95);
    border-width: 1px;
    border-radius: 5px;
    background-color: rgba(23, 10, 12, 0.98);
}

.top-menu-logout-button:hover {
    background-color: rgba(53, 21, 25, 0.72);
}

.top-menu-logout-button:active {
    background-color: rgba(114, 45, 32, 0.82);
}

.top-menu-logout-button > .unity-button__text {
    display: none;
}

.top-menu-logout-icon {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.top-menu-icon-logout {
    background-image: url("project://database/Assets/UI/Art/Icons/TopBar/topbar_logout.svg");
}
/* Floating Damage / Heal Numbers */

.dmg-number {
    position: absolute;
    -unity-font-style: bold;
    font-size: 28px;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    -unity-text-outline-width: 2px;
    margin-left: -30px;
    margin-top: -16px;
}

.dmg-number-damage {
    color: rgb(255, 82, 56);
}

.dmg-number-heal {
    color: rgb(72, 232, 88);
}
