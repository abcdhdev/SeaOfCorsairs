<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Core/Resources/Shared/OverlayPanel.uss?fileID=7433441132597879392&amp;guid=6b64251aafd24422b01cd1f0e6ef26f5&amp;type=3#OverlayPanel"/>
    <Style src="project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/ArubaCauldron.uss?fileID=7433441132597879392&amp;guid=bd28e2028fcdabc4f96d001748bdc0eb&amp;type=3#ArubaCauldron"/>
    <ui:VisualElement name="ArubaCauldronOverlay" class="window-overlay-root aruba-cauldron-overlay-root">
        <ui:VisualElement name="ArubaCauldronPanel" class="window-panel aruba-cauldron-panel" style="top: 86px; left: 48px;">
            <ui:VisualElement name="ArubaCauldronHeader" class="window-header aruba-cauldron-topbar">
                <ui:VisualElement class="aruba-cauldron-tab-strip">
                    <ui:Button text="Cauldron of Aruba" class="window-tab-button window-tab-button-selected aruba-cauldron-tab-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="aruba-cauldron-top-actions">
                    <ui:Button name="ArubaCauldronHelpButton" text="?" class="window-close-button aruba-cauldron-icon-button"/>
                    <ui:Button name="ArubaCauldronCloseButton" text="X" class="window-close-button aruba-cauldron-icon-button aruba-cauldron-close-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="aruba-cauldron-message-bar" style="margin-top: 3px; margin-left: 14px; margin-right: 14px; margin-bottom: 2px;">
                <ui:Label name="ArubaCauldronStatusLabel" text="Captain Barak Vane can transmute mojo into a fresh haul of supplies." class="aruba-cauldron-status-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="window-body aruba-cauldron-main">
                <ui:VisualElement class="aruba-cauldron-left-panel">
                    <ui:VisualElement class="aruba-cauldron-art-panel" style="margin-top: 14px; margin-right: 14px; margin-bottom: 14px; margin-left: 14px;">
                        <ui:VisualElement class="aruba-cauldron-portrait-frame">
                            <ui:VisualElement name="ArubaCauldronPortraitImage" class="aruba-cauldron-portrait-image"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="aruba-cauldron-portrait-copy">
                            <ui:Label text="Captain Barak Vane" class="aruba-cauldron-portrait-caption"/>
                            <ui:Label text="Keeper of the Cauldron of Aruba" class="aruba-cauldron-portrait-subcaption"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="aruba-cauldron-center-panel">
                    <ui:VisualElement name="ArubaCauldronLootSection" class="aruba-cauldron-loot-section">
                        <ui:VisualElement class="aruba-cauldron-section-title-wrap">
                            <ui:Label text="Loot" class="aruba-cauldron-section-title"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="ArubaCauldronLootBox" class="aruba-cauldron-content-box aruba-cauldron-loot-box" style="margin-top: 14px; margin-right: 14px; margin-bottom: 5px; margin-left: 14px;">
                            <ui:Label name="ArubaCauldronRewardsHintLabel" text="Every mojo has an even chance to become one of these rewards." class="aruba-cauldron-hint-label"/>
                            <ui:VisualElement name="ArubaCauldronRewardsGrid" class="aruba-cauldron-rewards-grid"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="aruba-cauldron-bottom-controls">
                        <ui:VisualElement class="aruba-cauldron-currencies" style="margin-top: 5px; margin-right: 14px; margin-bottom: 14px; margin-left: 14px; bottom: 0; top: auto;">
                            <ui:VisualElement class="aruba-cauldron-currency-row">
                                <ui:VisualElement name="ArubaCauldronMojoIcon" class="aruba-cauldron-currency-icon aruba-cauldron-currency-icon-mojo"/>
                                <ui:VisualElement class="aruba-cauldron-currency-copy">
                                    <ui:Label text="Mojo" class="aruba-cauldron-currency-name"/>
                                    <ui:Label name="ArubaCauldronMojoValueLabel" text="0" class="aruba-cauldron-currency-value"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="aruba-cauldron-currency-row">
                                <ui:VisualElement name="ArubaCauldronDiamondIcon" class="aruba-cauldron-currency-icon aruba-cauldron-currency-icon-diamond"/>
                                <ui:VisualElement class="aruba-cauldron-currency-copy">
                                    <ui:Label text="Diamonds" class="aruba-cauldron-currency-name"/>
                                    <ui:Label name="ArubaCauldronDiamondValueLabel" text="0" class="aruba-cauldron-currency-value"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="aruba-cauldron-control-area" style="margin-top: 5px; margin-right: 14px; margin-bottom: 14px; margin-left: 14px;">
                            <ui:VisualElement class="aruba-cauldron-input-wrap">
                                <ui:DropdownField name="ArubaCauldronQuantityDropdown" label="Quantity" class="aruba-cauldron-quantity-dropdown"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="aruba-cauldron-cost-box">
                                <ui:Label text="Diamond Cost" class="aruba-cauldron-cost-caption"/>
                                <ui:VisualElement class="aruba-cauldron-cost-group">
                                    <ui:VisualElement name="ArubaCauldronDiamondCostIcon" class="aruba-cauldron-currency-icon aruba-cauldron-currency-icon-diamond"/>
                                    <ui:Label name="ArubaCauldronDiamondCostValueLabel" text="0" class="aruba-cauldron-cost-value"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="ArubaCauldronPaymentHintLabel" text="Uses 1 mojo from your stockpile." class="aruba-cauldron-payment-hint"/>
                            <ui:VisualElement class="aruba-cauldron-buttons">
                                <ui:Button name="ArubaCauldronStartButton" text="Start Ritual" class="aruba-cauldron-primary-button"/>
                                <ui:Button name="ArubaCauldronClearButton" text="Clear Results" class="aruba-cauldron-secondary-button"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="aruba-cauldron-right-panel">
                    <ui:VisualElement class="aruba-cauldron-section-title-wrap">
                        <ui:Label text="Bonus Maps" class="aruba-cauldron-section-title"/>
                    </ui:VisualElement>
                    <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="aruba-cauldron-content-box aruba-cauldron-maps-box" style="margin-top: 14px; margin-right: 14px; margin-bottom: 14px; margin-left: 14px;">
                        <ui:VisualElement name="ArubaCauldronBonusMapsList" class="aruba-cauldron-bonus-list">
                            <ui:VisualElement class="aruba-cauldron-map-entry">
                                <ui:VisualElement class="aruba-cauldron-map-icon aruba-cauldron-map-icon-virgo"/>
                                <ui:VisualElement class="aruba-cauldron-map-text">
                                    <ui:Label text="Virgo Map" class="aruba-cauldron-map-title"/>
                                    <ui:Label text="Map pieces" class="aruba-cauldron-map-subtitle"/>
                                    <ui:Label text="Completed" class="aruba-cauldron-map-subtitle"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="aruba-cauldron-map-values">
                                    <ui:Label text="1/20" class="aruba-cauldron-map-value"/>
                                    <ui:Label text="479" class="aruba-cauldron-map-value aruba-cauldron-map-value-completed"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="aruba-cauldron-map-entry">
                                <ui:VisualElement class="aruba-cauldron-map-icon aruba-cauldron-map-icon-capricorn"/>
                                <ui:VisualElement class="aruba-cauldron-map-text">
                                    <ui:Label text="Capricorn Map" class="aruba-cauldron-map-title"/>
                                    <ui:Label text="Map pieces" class="aruba-cauldron-map-subtitle"/>
                                    <ui:Label text="Completed" class="aruba-cauldron-map-subtitle"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="aruba-cauldron-map-values">
                                    <ui:Label text="2/32" class="aruba-cauldron-map-value"/>
                                    <ui:Label text="240" class="aruba-cauldron-map-value aruba-cauldron-map-value-completed"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="aruba-cauldron-map-entry">
                                <ui:VisualElement class="aruba-cauldron-map-icon aruba-cauldron-map-icon-sagittarius"/>
                                <ui:VisualElement class="aruba-cauldron-map-text">
                                    <ui:Label text="Sagittarius Map" class="aruba-cauldron-map-title"/>
                                    <ui:Label text="Map pieces" class="aruba-cauldron-map-subtitle"/>
                                    <ui:Label text="Completed" class="aruba-cauldron-map-subtitle"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="aruba-cauldron-map-values">
                                    <ui:Label text="16/48" class="aruba-cauldron-map-value"/>
                                    <ui:Label text="123" class="aruba-cauldron-map-value aruba-cauldron-map-value-completed"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="aruba-cauldron-map-entry">
                                <ui:VisualElement class="aruba-cauldron-map-icon aruba-cauldron-map-icon-cancer"/>
                                <ui:VisualElement class="aruba-cauldron-map-text">
                                    <ui:Label text="Cancer Map" class="aruba-cauldron-map-title"/>
                                    <ui:Label text="Map pieces" class="aruba-cauldron-map-subtitle"/>
                                    <ui:Label text="Completed" class="aruba-cauldron-map-subtitle"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="aruba-cauldron-map-values">
                                    <ui:Label text="49/64" class="aruba-cauldron-map-value"/>
                                    <ui:Label text="79" class="aruba-cauldron-map-value aruba-cauldron-map-value-completed"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
