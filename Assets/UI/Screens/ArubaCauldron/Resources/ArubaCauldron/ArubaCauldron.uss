:root {
    --aruba-gold: rgba(198, 155, 92, 0.98);
    --aruba-gold-soft: rgba(96, 68, 31, 0.96);
    --aruba-red: rgba(70, 14, 16, 0.99);
    --aruba-red-soft: rgba(41, 8, 10, 0.99);
    --aruba-panel: rgba(6, 15, 24, 0.98);
    --aruba-panel-soft: rgba(9, 20, 31, 0.96);
    --aruba-text: rgba(236, 228, 210, 0.98);
    --aruba-muted: rgba(181, 170, 148, 0.9);
    --aruba-blue: rgba(102, 180, 255, 0.98);
    --aruba-green: rgba(112, 216, 114, 0.98);
    --aruba-danger: rgba(255, 145, 112, 0.99);
}

.aruba-cauldron-overlay-root {
    display: flex;
    background-color: rgba(2, 10, 18, 0.48);
}

.aruba-cauldron-panel {
    flex-direction: column;
    width: 1440px;
    max-width: 96%;
    height: 820px;
    max-height: 88%;
    padding-top: 0;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: var(--aruba-gold-soft);
    border-right-color: var(--aruba-gold-soft);
    border-bottom-color: var(--aruba-gold-soft);
    border-left-color: var(--aruba-gold-soft);
    background-color: rgba(5, 12, 18, 0.99);
}

.aruba-cauldron-topbar {
    height: 66px;
    min-height: 66px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-right: -18px;
    margin-left: -18px;
    padding-top: 10px;
    padding-right: 16px;
    padding-bottom: 10px;
    padding-left: 16px;
    border-bottom-width: 2px;
    border-bottom-color: var(--aruba-gold-soft);
    background-color: var(--aruba-red);
}

.aruba-cauldron-tab-strip {
    flex-direction: row;
    align-items: center;
}

.aruba-cauldron-tab-button {
    min-width: 196px;
    height: 40px;
    padding-right: 18px;
    padding-left: 18px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--aruba-gold);
    border-right-color: var(--aruba-gold);
    border-bottom-color: var(--aruba-gold);
    border-left-color: var(--aruba-gold);
    background-color: rgba(14, 13, 14, 0.98);
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 16px;
}

.aruba-cauldron-top-actions {
    flex-direction: row;
    align-items: center;
    column-gap: 10px;
}

.aruba-cauldron-icon-button {
    width: 34px;
    min-width: 34px;
    height: 34px;
    min-height: 34px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--aruba-gold-soft);
    border-right-color: var(--aruba-gold-soft);
    border-bottom-color: var(--aruba-gold-soft);
    border-left-color: var(--aruba-gold-soft);
    background-color: rgba(31, 20, 12, 0.98);
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 14px;
}

.aruba-cauldron-icon-button:hover {
    background-color: rgba(45, 30, 18, 0.99);
}

.aruba-cauldron-message-bar {
    min-height: 54px;
    justify-content: center;
    align-items: center;
    margin-top: 14px;
    margin-bottom: 10px;
    padding-top: 10px;
    padding-right: 18px;
    padding-bottom: 10px;
    padding-left: 18px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--aruba-gold-soft);
    border-right-color: var(--aruba-gold-soft);
    border-bottom-color: var(--aruba-gold-soft);
    border-left-color: var(--aruba-gold-soft);
    background-color: rgba(57, 10, 12, 0.95);
}

.aruba-cauldron-status-label {
    color: var(--aruba-text);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.aruba-cauldron-status-success {
    color: rgba(165, 237, 166, 0.98);
}

.aruba-cauldron-status-error {
    color: var(--aruba-danger);
}

.aruba-cauldron-main {
    flex-grow: 1;
    flex-direction: row;
    column-gap: 12px;
    min-height: 0;
}

.aruba-cauldron-left-panel {
    flex-direction: column;
    width: 300px;
    min-width: 300px;
}

.aruba-cauldron-center-panel {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.aruba-cauldron-right-panel {
    flex-direction: column;
    width: 410px;
    min-width: 410px;
    min-height: 0;
}

.aruba-cauldron-art-panel,
.aruba-cauldron-loot-box,
.aruba-cauldron-maps-box,
.aruba-cauldron-currencies,
.aruba-cauldron-control-area {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--aruba-gold-soft);
    border-right-color: var(--aruba-gold-soft);
    border-bottom-color: var(--aruba-gold-soft);
    border-left-color: var(--aruba-gold-soft);
}

.aruba-cauldron-art-panel {
    height: 100%;
    justify-content: center;
    align-items: center;
    padding-top: 24px;
    padding-right: 20px;
    padding-bottom: 24px;
    padding-left: 20px;
    background-color: rgba(25, 36, 23, 0.98);
}

.aruba-cauldron-portrait-frame {
    width: 224px;
    height: 224px;
    min-width: 224px;
    min-height: 224px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(219, 196, 159, 0.42);
    border-right-color: rgba(219, 196, 159, 0.42);
    border-bottom-color: rgba(219, 196, 159, 0.42);
    border-left-color: rgba(219, 196, 159, 0.42);
    border-top-left-radius: 112px;
    border-top-right-radius: 112px;
    border-bottom-right-radius: 112px;
    border-bottom-left-radius: 112px;
    background-color: rgba(15, 23, 16, 0.98);
}

.aruba-cauldron-portrait-image {
    width: 100%;
    height: 100%;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.aruba-cauldron-portrait-copy {
    align-items: center;
    margin-top: 18px;
}

.aruba-cauldron-portrait-caption {
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 21px;
    -unity-text-align: middle-center;
}

.aruba-cauldron-portrait-subcaption {
    margin-top: 6px;
    color: var(--aruba-muted);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.aruba-cauldron-section-title-wrap {
    height: 36px;
    justify-content: center;
    align-items: center;
}

.aruba-cauldron-section-title {
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 18px;
}

.aruba-cauldron-loot-section {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.aruba-cauldron-content-box {
    background-color: var(--aruba-panel);
}

.aruba-cauldron-loot-box {
    flex-grow: 1;
    min-height: 0;
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    background-color: rgba(4, 18, 29, 0.98);
}

.aruba-cauldron-hint-label {
    margin-bottom: 12px;
    color: var(--aruba-muted);
    font-size: 13px;
    white-space: normal;
}

.aruba-cauldron-rewards-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    column-gap: 12px;
    row-gap: 12px;
    min-height: 0;
}

.aruba-cauldron-reward-tile {
    flex-grow: 0;
    flex-shrink: 0;
    width: 160px;
    min-width: 160px;
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    align-items: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(216, 199, 170, 0.18);
    border-right-color: rgba(216, 199, 170, 0.18);
    border-bottom-color: rgba(216, 199, 170, 0.18);
    border-left-color: rgba(216, 199, 170, 0.18);
    background-color: rgba(10, 16, 24, 0.98);
}

.aruba-cauldron-reward-accent-cannon {
    background-color: rgba(14, 19, 31, 0.98);
}

.aruba-cauldron-reward-accent-harpoon {
    background-color: rgba(11, 20, 25, 0.98);
}

.aruba-cauldron-reward-accent-armor {
    background-color: rgba(13, 21, 18, 0.98);
}

.aruba-cauldron-reward-accent-powder {
    background-color: rgba(18, 13, 15, 0.98);
}

.aruba-cauldron-reward-icon-frame {
    width: 72px;
    height: 72px;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--aruba-gold-soft);
    border-right-color: var(--aruba-gold-soft);
    border-bottom-color: var(--aruba-gold-soft);
    border-left-color: var(--aruba-gold-soft);
    background-color: rgba(21, 12, 11, 0.78);
}

.aruba-cauldron-reward-icon-image {
    width: 56px;
    height: 56px;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.aruba-cauldron-reward-icon-fallback {
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.aruba-cauldron-reward-amount {
    color: var(--aruba-blue);
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.aruba-cauldron-bottom-controls {
    min-height: 190px;
    margin-top: 10px;
    flex-direction: row;
    column-gap: 10px;
}

.aruba-cauldron-currencies {
    width: 250px;
    min-width: 250px;
    justify-content: center;
    row-gap: 16px;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 20px;
    background-color: rgba(7, 12, 18, 0.98);
}

.aruba-cauldron-currency-row {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
}

.aruba-cauldron-currency-icon {
    width: 50px;
    min-width: 20px;
    height: 50px;
    min-height: 20px;
    margin-right: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    border-left-color: rgba(255, 255, 255, 0.14);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    display: flex;
    overflow: visible;
    aspect-ratio: 1;
}

.aruba-cauldron-currency-icon-mojo {
    background-image: url("project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/Mojo.png?fileID=2800000&guid=8b8479aa535a06942a2986c9377843a3&type=3#Mojo");
    background-color: rgba(255, 255, 255, 0);
}

.aruba-cauldron-currency-icon-diamond {
    background-image: url("project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/Diamond.png?fileID=2800000&guid=6118cd2c5fb35cc4bb238b2c64a004fe&type=3#Diamond");
    background-color: rgba(255, 255, 255, 0);
}

.aruba-cauldron-currency-copy {
    flex-grow: 1;
}

.aruba-cauldron-currency-name {
    color: var(--aruba-muted);
    font-size: 12px;
}

.aruba-cauldron-currency-value {
    margin-top: 4px;
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 24px;
}

.aruba-cauldron-control-area {
    flex-direction: column;
    flex-grow: 1;
    padding-top: 14px;
    padding-right: 16px;
    padding-bottom: 14px;
    padding-left: 16px;
    background-color: rgba(7, 15, 23, 0.98);
}

.aruba-cauldron-input-wrap {
    justify-content: center;
    margin-bottom: 10px;
}

.aruba-cauldron-quantity-dropdown {
    width: 100%;
}

.aruba-cauldron-quantity-dropdown .unity-base-field__label {
    color: var(--aruba-muted);
    font-size: 13px;
}

.aruba-cauldron-quantity-dropdown .unity-base-field__input {
    min-height: 40px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--aruba-gold-soft);
    border-right-color: var(--aruba-gold-soft);
    border-bottom-color: var(--aruba-gold-soft);
    border-left-color: var(--aruba-gold-soft);
    background-color: rgba(5, 8, 11, 0.99);
    color: var(--aruba-text);
}

.aruba-cauldron-cost-box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 10px;
}

.aruba-cauldron-cost-caption {
    margin-right: 18px;
    color: var(--aruba-muted);
    font-size: 14px;
}

.aruba-cauldron-cost-group {
    flex-direction: row;
    align-items: center;
}

.aruba-cauldron-cost-value {
    color: var(--aruba-blue);
    -unity-font-style: bold;
    font-size: 18px;
}

.aruba-cauldron-payment-hint {
    margin-bottom: 14px;
    color: var(--aruba-muted);
    font-size: 13px;
    white-space: normal;
}

.aruba-cauldron-buttons {
    flex-direction: row;
    column-gap: 12px;
    margin-top: auto;
}

.aruba-cauldron-primary-button,
.aruba-cauldron-secondary-button {
    min-height: 48px;
    -unity-font-style: bold;
    font-size: 16px;
}

.aruba-cauldron-primary-button {
    flex-grow: 1;
    border-top-color: rgba(95, 178, 97, 0.95);
    border-right-color: rgba(95, 178, 97, 0.95);
    border-bottom-color: rgba(95, 178, 97, 0.95);
    border-left-color: rgba(95, 178, 97, 0.95);
    background-color: rgba(48, 121, 50, 0.98);
    color: rgba(241, 245, 238, 0.99);
}

.aruba-cauldron-primary-button:hover {
    background-color: rgba(58, 139, 60, 0.99);
}

.aruba-cauldron-secondary-button {
    width: 196px;
    min-width: 196px;
    border-top-color: rgba(116, 116, 116, 0.94);
    border-right-color: rgba(116, 116, 116, 0.94);
    border-bottom-color: rgba(116, 116, 116, 0.94);
    border-left-color: rgba(116, 116, 116, 0.94);
    background-color: rgba(62, 62, 62, 0.98);
    color: var(--aruba-text);
}

.aruba-cauldron-secondary-button:hover {
    background-color: rgba(82, 82, 82, 0.99);
}

.aruba-cauldron-maps-box {
    flex-grow: 1;
    min-height: 0;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-color: rgba(5, 12, 18, 0.98);
}

.aruba-cauldron-maps-box .unity-scroll-view__content-container {
    background-color: transparent;
}

.aruba-cauldron-bonus-list {
    row-gap: 8px;
}

.aruba-cauldron-map-entry {
    flex-direction: row;
    align-items: center;
    min-height: 86px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(217, 199, 170, 0.15);
    border-right-color: rgba(217, 199, 170, 0.15);
    border-bottom-color: rgba(217, 199, 170, 0.15);
    border-left-color: rgba(217, 199, 170, 0.15);
    background-color: rgba(8, 13, 20, 0.96);
}

.aruba-cauldron-map-icon {
    width: 80px;
    min-width: 62px;
    height: 80px;
    min-height: 62px;
    margin-right: 12px;
    color: rgba(84, 46, 22, 0.98);
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(110, 78, 35, 0.96);
    border-right-color: rgba(110, 78, 35, 0.96);
    border-bottom-color: rgba(110, 78, 35, 0.96);
    border-left-color: rgba(110, 78, 35, 0.96);
    background-color: rgba(255, 255, 255, 0);
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    aspect-ratio: auto;
}

.aruba-cauldron-map-icon-virgo {
    background-image: url("project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/Virgo.png?fileID=2800000&guid=06d5dc61d0cf0f54e959ba9c47bcc837&type=3#Virgo");
}

.aruba-cauldron-map-icon-capricorn {
    background-image: url("project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/Capricornus.png?fileID=2800000&guid=5fc85e9557b37c748ae2f0a3e64a7168&type=3#Capricornus");
}

.aruba-cauldron-map-icon-sagittarius {
    background-image: url("project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/Sagittarius.png?fileID=2800000&guid=155cb9f36a62a024ea89ff88adccabb6&type=3#Sagittarius");
}

.aruba-cauldron-map-icon-cancer {
    background-image: url("project://database/Assets/UI/Screens/ArubaCauldron/Resources/ArubaCauldron/Cancer.png?fileID=2800000&guid=1f1b836b591fc8e49a094ed5e43bd9f1&type=3#Cancer");
}

.aruba-cauldron-map-text {
    flex-grow: 1;
}

.aruba-cauldron-map-title {
    color: var(--aruba-text);
    -unity-font-style: bold;
    font-size: 17px;
}

.aruba-cauldron-map-subtitle {
    margin-top: 4px;
    color: var(--aruba-muted);
    font-size: 12px;
}

.aruba-cauldron-map-values {
    width: 92px;
    align-items: flex-end;
}

.aruba-cauldron-map-value {
    color: var(--aruba-text);
    font-size: 13px;
}

.aruba-cauldron-map-value-completed {
    margin-top: 8px;
    color: var(--aruba-blue);
    -unity-font-style: bold;
}
