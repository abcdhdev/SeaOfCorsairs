<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="ShipSectionItemRow" class="window-item-row ship-section-item-row">
        <ui:VisualElement name="ShipSectionItemThumb" class="window-item-thumb ship-section-item-thumb">
            <ui:Label name="ShipSectionItemThumbLabel" text="SS" class="window-item-thumb-label ship-section-item-thumb-label"/>
        </ui:VisualElement>
        <ui:VisualElement class="window-item-meta ship-section-item-meta">
            <ui:Label name="ShipSectionItemNameLabel" text="Swiftwake Sloop" class="window-item-name ship-section-item-name"/>
            <ui:Label name="ShipSectionItemDescriptionLabel" text="Placeholder item description" class="window-item-description ship-section-item-description"/>
        </ui:VisualElement>
        <ui:Label name="ShipSectionItemStatusLabel" text="Current" class="window-item-price ship-section-item-status"/>
        <ui:VisualElement class="window-item-actions ship-section-item-actions">
            <ui:Button name="ShipSectionItemSelectButton" text="Select" class="window-stepper-button ship-section-select-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
